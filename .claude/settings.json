{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(timeout * ./mvnw *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(docker compose *)",
      "Bash(scripts/cluster-smoke.sh *)",
      "Bash(npm run *)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -s --max-time * http://localhost:*)",
      "Bash(jar tf *)",
      "Bash(unzip -l *)",
      "Bash(javap *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Read(./.env)",
      "Read(./**/*.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-fresh-tests.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/forbid-jackson2.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
